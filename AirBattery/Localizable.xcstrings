    "Nearby Apple devices may include Macs and Apple Watches. Select only your iPhone or iPad. Open Personal Hotspot and move it close to the Mac before connecting.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils Apple à proximité peuvent inclure des Mac et des Apple Watch. Ne sélectionnez que votre iPhone ou votre iPad. Ouvrez Partage de connexion et approchez-le du Mac avant de vous connecter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近设备可能包含 Mac 和 Apple Watch，请仅选择自己的 iPhone 或 iPad。连接前请打开“个人热点”页面并靠近 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近裝置可能包含 Mac 和 Apple Watch，請僅選擇自己的 iPhone 或 iPad。連線前請開啟「個人熱點」頁面並靠近 Mac。"
          }
        }
      }
    },
